# Copy to .env (never commit it). Frontend variables start with VITE_.

# Frontend: "api" reads content from the backend and enables the admin panel.
# Leave empty to use the bundled demo data (no server needed).
VITE_CONTENT_SOURCE=

# Backend (npm run server). Defaults are fine for local development.
PORT=8787
DATABASE_PATH=data/daneshpaz.sqlite
SESSION_TTL_HOURS=12
# Comma-separated browser origins allowed to send write requests (same-origin is always allowed).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true in production (HTTPS) so the session cookie is Secure. NODE_ENV=production does this by default.
COOKIE_SECURE=
# Set true only when running behind a reverse proxy you control (reads X-Forwarded-For for rate limiting).
TRUST_PROXY=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Used only by `npm run admin:create -- you@example.com` (min 10 chars). If empty, a random one is generated and printed once.
ADMIN_PASSWORD=
